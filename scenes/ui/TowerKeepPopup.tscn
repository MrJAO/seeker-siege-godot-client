[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/TowerKeepPopup.gd" id="1"]
[ext_resource type="StyleBox" path="res://assets/ui/popup_cyan_panel_style.tres" id="2"]
[ext_resource type="Texture2D" path="res://assets/decoratives/bg_images/border.png" id="3"]

[node name="TowerKeepPopup" type="PanelContainer"]
custom_minimum_size = Vector2(400, 300)
# Explicit, not relying on whatever the default happens to be - Pass on
# a card inside lets a scroll gesture reach this popup's own
# ScrollContainer, but without Stop here that same event also keeps
# going past the whole popup to the map tiles behind it.
mouse_filter = 0
anchor_left = 0.1
anchor_top = 0.1
anchor_right = 0.9
anchor_bottom = 0.9
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("2")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 220
theme_override_constants/margin_top = 90
theme_override_constants/margin_right = 220
theme_override_constants/margin_bottom = 50

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
horizontal_alignment = 1
text = "Your token holdings dropped"
theme_override_font_sizes/font_size = 30

[node name="SubtitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 2
theme_override_font_sizes/font_size = 18
text = "Choose which towers to disable - disabled towers come back automatically once your balance covers them again."

[node name="CountLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20
text = "Enabled: 0 / 0"

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
